	cd /d C:\Users\Technik\Documents\kody\Tymek\kody\Space_Gaming_Zombies\build && $(CMAKE_COMMAND) -S$(CMAKE_SOURCE_DIR) -B$(CMAKE_BINARY_DIR) --check-build-system CMakeFiles\Makefile.cmake 0
